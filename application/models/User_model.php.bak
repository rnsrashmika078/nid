            $likeCriteria = "(BaseTbl.instrument_name  LIKE '%".$searchText."%'
                            OR  Institute.name  LIKE '%".$searchText."%'
                            OR  iType.instrument_type  LIKE '%".$searchText."%'
              OR  BaseTbl.inst_keywords  LIKE '%".$searchText."%'
