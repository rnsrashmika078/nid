<?php if ( ! defined('BASEPATH')) exit('No direct script access allowed');

class Home_model extends CI_Model {

  function getInstrument($postData){
 
    $response = array();
  
    $this->db->select('*');

    if($postData['search'] ){
 
      // Select record
      $this->db->where("instrument_name like '%".$postData['search']."%' ");
      
      $records = $this->db->get('instrument')->result();

      foreach($records as $row ){
        $response[] = array("value"=>$row->instrument_id,"label"=>$row->instrument_name);
      }
 
    }
	
	
	
	
	
	if($postData['search'] ){
 
      // Select record
      $this->db->where("keyword1 like '%".$postData['search']."%' ");
      
      $records = $this->db->get('instrument')->result();

      foreach($records as $row ){
        $response[] = array("value"=>$row->instrument_id,"label"=>$row->keyword1);
      }
 
    }
	
	if($postData['search'] ){
 
      // Select record
      $this->db->where("keyword2 like '%".$postData['search']."%' ");
      
      $records = $this->db->get('instrument')->result();

      foreach($records as $row ){
        $response[] = array("value"=>$row->instrument_id,"label"=>$row->keyword2);
      }
 
    }
	
	if($postData['search'] ){
 
      // Select record
      $this->db->where("keyword3 like '%".$postData['search']."%' ");
      
      $records = $this->db->get('instrument')->result();

      foreach($records as $row ){
        $response[] = array("value"=>$row->instrument_id,"label"=>$row->keyword3);
      }
 
    }
	
	if($postData['search'] ){
 
      // Select record
      $this->db->where("keyword4 like '%".$postData['search']."%' ");
      
      $records = $this->db->get('instrument')->result();

      foreach($records as $row ){
        $response[] = array("value"=>$row->instrument_id,"label"=>$row->keyword4);
      }
 
    }
	
	if($postData['search'] ){
 
      // Select record
      $this->db->where("keyword5 like '%".$postData['search']."%' ");
      
      $records = $this->db->get('instrument')->result();

      foreach($records as $row ){
        $response[] = array("value"=>$row->instrument_id,"label"=>$row->keyword5);
      }
 
    }
	
	if($postData['search'] ){
 
      // Select record
      $this->db->where("keyword6 like '%".$postData['search']."%' ");
      
      $records = $this->db->get('instrument')->result();

      foreach($records as $row ){
        $response[] = array("value"=>$row->instrument_id,"label"=>$row->keyword6);
      }
 
    }
	
	
	if($postData['search'] ){
 
      // Select record
      $this->db->where("name like '%".$postData['search']."%' ");
      
      $records = $this->db->get('institutes')->result();

      foreach($records as $row ){
        $response[] = array("value"=>$row->institute_id,"label"=>$row->name);
      }
 
    }
	
	
    
    return $response;
  }
  
  
    
    
  
  
  
   /**
     * This function used to get instrument information by id
     * @param number $taskId : This is instrument id
     * @return array $result : This is Instrument information
     */
    function getInstrumentInfo($instrumentId)
    {
        $this->db->select('*');
        $this->db->from('instrument as BaseTbl');
		$this->db->join('institutes as Institute','Institute.institute_id = BaseTbl.institute_id', 'left');
		$this->db->join('faculties as Faculty','Faculty.faculty_id = BaseTbl.faculty_id', 'left');
		$this->db->join('departments as Department','Department.department_id = BaseTbl.department_id', 'left');
		$this->db->join('laboratories as laboratory','laboratory.laboratory_id = BaseTbl.laboratory_id', 'left');
		$this->db->join('instrument_types as iType','iType.instrument_type_id = BaseTbl.instrument_type_id', 'left');
		$this->db->join('instrument_condition as condition','condition.condition_id = BaseTbl.condition_id', 'left');
        $this->db->where('BaseTbl.isDeleted', 0);
        $this->db->where('BaseTbl.instrument_id', $instrumentId);
        $query = $this->db->get();

        return $query->result();
    }
	
	/**
     * This function is used to get the user Instrument count
     * @param string $searchText : This is optional search text
     * @return number $count : This is row count
     */
    function instrumentListingCount($searchText = '')
    {
       $this->db->select('BaseTbl.instrument_id,BaseTbl.instrument_name,Institute.name,BaseTbl.contact_person_name,BaseTbl.contact_person_email,BaseTbl.contact_person_phone_number,BaseTbl.contact_person_mobile_number,BaseTbl.keyword1,BaseTbl.keyword2,BaseTbl.keyword3,BaseTbl.keyword4,BaseTbl.keyword5,BaseTbl.keyword6,BaseTbl.record_status');
        $this->db->from('instrument as BaseTbl');
        $this->db->join('users as U','U.id = BaseTbl.created_user_id');
        $this->db->join('user_types as Roles','Roles.user_type_id = U.user_type_id');
        $this->db->join('institutes as Institute','Institute.institute_id = BaseTbl.institute_id');
  //  $this->db->join('instrument_types as iType','iType.instrument_type_id = BaseTbl.instrument_type_id');
        if(!empty($searchText)) {
            $likeCriteria = "(BaseTbl.instrument_name  LIKE '%".$searchText."%'
			OR BaseTbl.keyword1  LIKE '%".$searchText."%'
			OR BaseTbl.keyword2  LIKE '%".$searchText."%'
			OR BaseTbl.keyword3  LIKE '%".$searchText."%'
			OR BaseTbl.keyword4  LIKE '%".$searchText."%'
			OR BaseTbl.keyword5  LIKE '%".$searchText."%'
			OR BaseTbl.keyword6  LIKE '%".$searchText."%'
                            OR  Institute.name  LIKE '%".$searchText."%'
                            OR  U.last_name  LIKE '%".$searchText."%')";
            $this->db->where($likeCriteria);
        }
        $this->db->where('BaseTbl.isDeleted', 0);
        $query = $this->db->get();

        return $query->num_rows();
    }

  /**
     * This function is used to get the user listing count
     * @param string $searchText : This is optional search text
     * @param number $page : This is pagination offset
     * @param number $segment : This is pagination limit
     * @return array $result : This is result
     */
    function instrumentListing($searchText = '', $page, $segment)
    {
        $this->db->select('BaseTbl.instrument_id,BaseTbl.instrument_name,Institute.name,BaseTbl.contact_person_name,BaseTbl.contact_person_email,BaseTbl.contact_person_phone_number,BaseTbl.contact_person_mobile_number,BaseTbl.keyword1,BaseTbl.keyword2,BaseTbl.keyword3,BaseTbl.keyword4,BaseTbl.keyword5,BaseTbl.keyword6,BaseTbl.record_status');
        $this->db->from('instrument as BaseTbl');
        $this->db->join('users as U','U.id = BaseTbl.created_user_id');
        $this->db->join('user_types as Roles','Roles.user_type_id = U.user_type_id');
        $this->db->join('institutes as Institute','Institute.institute_id = BaseTbl.institute_id');
       // $this->db->join('instrument_types as iType','iType.instrument_type_id = BaseTbl.instrument_type_id');
        if(!empty($searchText)) {
            $likeCriteria = "(BaseTbl.instrument_name  LIKE '%".$searchText."%'
			OR BaseTbl.keyword1  LIKE '%".$searchText."%'
			OR BaseTbl.keyword2  LIKE '%".$searchText."%'
			OR BaseTbl.keyword3  LIKE '%".$searchText."%'
			OR BaseTbl.keyword4  LIKE '%".$searchText."%'
			OR BaseTbl.keyword5  LIKE '%".$searchText."%'
			OR BaseTbl.keyword6  LIKE '%".$searchText."%'
			
                            OR  Institute.name  LIKE '%".$searchText."%'
                            OR  U.last_name  LIKE '%".$searchText."%')";
            $this->db->where($likeCriteria);
        }
        $this->db->where('BaseTbl.isDeleted', 0);
        $this->db->limit($page, $segment);
    $this->db->order_by('BaseTbl.instrument_id ASC,BaseTbl.record_status');
        $query = $this->db->get();

        $result = $query->result();
        return $result;
    }

}