function loadViews($viewName = "", $headerInfo = NULL, $pageInfo = NULL, $footerInfo = NULL){

        $this->load->view('includes/headerE', $headerInfo);
        $this->load->view($viewName, $pageInfo);
        $this->load->view('includes/footerE', $footerInfo);
    }

